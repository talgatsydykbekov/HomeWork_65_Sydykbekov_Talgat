@using Microsoft.EntityFrameworkCore.Migrations
@model List<MyUser>

@{
    ViewBag.Title = "Все пользователи";
}


<div class="container py-4">
    <div class="text-center mb-4">
        <h1 class="fw-bold">Список пользователей</h1>
        <p class="text-muted">Табличный список с действиями</p>
    </div>


    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
        <tr>
            <th scope="col">Аватар</th>
            <th scope="col">Логин</th>
            <th scope="col">Email</th>
            <th scope="col">Возраст</th>
            <th scope="col" class="text-center">Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var us in Model)
        {
            <tr>
                <td>
                    <img src="/@us.Avatar" class="rounded-circle border" alt="@us.UserName" style="width:50px;height:50px;object-fit:cover;">
                </td>
                <td>@us.UserName</td>
                <td>@us.Email</td>
                <td>@(us.Age)</td>
                <td class="text-center">
                    <a asp-controller="MyUser" asp-action="Edit" asp-route-id="@us.Id" class="btn btn-sm btn-primary me-2">
                        <i class="bi bi-pencil-square"></i> Редактировать
                    </a>
                    @if (us.IsBlocked)
                    {
                        <a asp-controller="MyUser" asp-action="UnBlock" asp-route-id="@us.Id" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-slash-circle"></i> Разблокировать
                        </a>
                    }
                    else
                    {
                        <a asp-controller="MyUser" asp-action="Block" asp-route-id="@us.Id" class="btn btn-sm btn-danger">
                            <i class="bi bi-slash-circle"></i> Блокировать
                        </a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>


    <div class="text-center mt-3">
        <a asp-controller="MyUser" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Добавить пользователя
        </a>
    </div>
</div>