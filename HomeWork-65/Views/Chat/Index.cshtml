@model List<Message>

@{
    ViewBag.Title = "Чат";
}
@if (TempData["RegistrationNotice"] is string notice)
{
    <div class="alert alert-info" role="status">@notice</div>
}
<style>
    .container > .border { scrollbar-width: thin; scrollbar-color: #6c757d #e9ecef; }
    .container > .border::-webkit-scrollbar { width: 16px; }
    .container > .border::-webkit-scrollbar-thumb { background-color: #6c757d; border-radius: 4px; }
    .container > .border::-webkit-scrollbar-track { background-color: #e9ecef; border-radius: 4px; }
</style>

<div class="container py-4">

    <div class="container py-3" style="max-width: 700px;">
        <div class="border rounded p-3" style="height:500px; overflow-y:auto; background:#f9f9f9;">
            <div id="messages"></div>
        </div>
    </div>

    <div class="mt-3 d-flex">
        <input type="text" class="form-control me-2" id="content" placeholder="Введите сообщение" maxlength="120" required>
        <button type="button" class="btn btn-primary" id="send">Отправить</button>
    </div>
    <div id="chat-error" class="text-danger mt-2" role="alert"></div>
</div>





@section Scripts
{
    <script>
        function scrollToBottom() {
            const chatContainer = document.querySelector(".container > .border");
            if (chatContainer) {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        }
        function loadMessages() {
            $.ajax({
                url: '@Url.Action("GetMessages", "Chat")',
                success: function (html) {
                    $('#messages').html(html);
                    scrollToBottom();
                },
                error: function () {
                    $('#chat-error').text('Не удалось загрузить сообщения. Обновите страницу и проверьте вход.');
                }
            });
        }
        $('#send').click(function (){
           const message = $('#content').val().trim();
           if (!message) return;
           $('#chat-error').text('');
           $('#send').prop('disabled', true);
           $.ajax({
               url: '@Url.Action("SendMessage", "Chat")',
               type: "POST",
               data: {
                   'message' : message
               },
               success: function (){
                   $('#content').val('');
                   loadMessages();
               },
               error: function () {
                   $('#chat-error').text('Не удалось отправить сообщение. Проверьте вход и попробуйте снова.');
               },
               complete: function () {
                   $('#send').prop('disabled', false);
               }
           });
        });
        loadMessages();
        setInterval(loadMessages, 5000);
    
    </script>
}






