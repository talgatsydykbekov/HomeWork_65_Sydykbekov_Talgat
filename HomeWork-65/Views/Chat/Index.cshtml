@model List<Message>

@{
    ViewBag.Title = "Чат";
}
<div class="container py-4">
    
    <div id="messages">
        
    </div>

    <div class="mt-3 d-flex">
        <input type="text" class="form-control me-2" id="content" placeholder="Введите сообщение" required>
        <button type="button" class="btn btn-primary" id="send">Отправить</button>
    </div>
</div>




@section Scripts
{
    <script>
        $('#send').click(function (){
           $.ajax({
               url: '@Url.Action("SendMessage","Chat")',
               type: "POST",
               data: {
                   'message' : $('#content').val()
               },
               success: console.log("Ok")
           });
        });
        let interval = setInterval(function (){
            $('#messages').load('@Url.Action("GetMessages","Chat")' )
        },5000)
    </script>
}







<style>
    .container > .border { scrollbar-width: thin; scrollbar-color: #6c757d #e9ecef; }
    .container > .border::-webkit-scrollbar { width: 8px; }
    .container > .border::-webkit-scrollbar-thumb { background-color: #6c757d; border-radius: 4px; }
    .container > .border::-webkit-scrollbar-track { background-color: #e9ecef; border-radius: 4px; }
</style>